# Banco PostgreSQL (Supabase/Neon ou local)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/cleanmail
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
AUTO_MIGRATE=true

# Autenticação
JWT_SECRET=troque-por-uma-chave-secreta-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_TROQUE_AQUI
STRIPE_WEBHOOK_SECRET=whsec_TROQUE_AQUI
STRIPE_PRICE_STARTER_BRL=price_TROQUE_AQUI
STRIPE_PRICE_STARTER_EUR=price_TROQUE_AQUI
STRIPE_PRICE_STARTER_USD=price_TROQUE_AQUI
STRIPE_PRICE_PRO_BRL=price_TROQUE_AQUI
STRIPE_PRICE_PRO_EUR=price_TROQUE_AQUI
STRIPE_PRICE_PRO_USD=price_TROQUE_AQUI
STRIPE_PRICE_ENTERPRISE_BRL=price_TROQUE_AQUI
STRIPE_PRICE_ENTERPRISE_EUR=price_TROQUE_AQUI
STRIPE_PRICE_ENTERPRISE_USD=price_TROQUE_AQUI

# Redis é opcional: BullMQ só é usado fora da Vercel quando definido
REDIS_URL=redis://localhost:6379

# Verificador SMTP
SMTP_HELO_DOMAIN=cleanmail.com.br
SMTP_FROM_EMAIL=verify@cleanmail.com.br
SMTP_TIMEOUT_MS=7500

# Servidor
PORT=3333
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
VERCEL=0
